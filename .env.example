# AIGP Coach — every variable here is OPTIONAL. The app builds and runs with
# none of them: all study content is bundled TypeScript and progress lives in
# the browser's localStorage.
#
# There is no LLM or AI API key anywhere in this app — nothing calls a model.

# ── Supabase (one free project unlocks all three extras) ─────────────────────
# Enables: accounts (email + password), the anonymous sync code, and serving
# the law-updates feed from the DB instead of the bundle.
# Setup: create a project at supabase.com, open its SQL Editor, run
# supabase/progress_sync.sql and supabase/accounts.sql, then paste the
# Project URL and anon/public key from Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Private instance ─────────────────────────────────────────────────────────
# "true" locks the whole app behind login (register/login screen first).
# Leave false/unset for the public behaviour: accounts stay optional.
NEXT_PUBLIC_REQUIRE_AUTH=false
